# HTTP server
HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
HTTP_READ_HEADER_TIMEOUT=2s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_UPLOAD_BYTES=10485760
# Worker's admin HTTP server (/health, /metrics). Server binary ignores it.
WORKER_ADMIN_PORT=8081

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Observability (OpenTelemetry tracing)
# Toggle tracing. With it on, the app exports OTLP/gRPC to OTEL_EXPORTER_OTLP_ENDPOINT.
OTEL_ENABLED=true
# Host-run app -> Jaeger's published OTLP port (compose maps 4317 to the host).
# Inside compose this is overridden to jaeger:4317.
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_ENVIRONMENT=local
# Head-sampling ratio for root spans. 1.0 = trace everything (good for dev).
OTEL_TRACES_SAMPLER_RATIO=1.0

# PostgreSQL
POSTGRES_DSN=postgres://avatars:avatars@localhost:5433/avatars?sslmode=disable

# MinIO (S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=avatars
MINIO_USE_SSL=false

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5673/
RABBITMQ_EXCHANGE=avatars.exchange

# Security
# Comma-separated origin whitelist for CORS. Empty = deny all cross-origin.
CORS_ALLOWED_ORIGINS=
# Requests-per-minute caps. 0 disables the limiter.
RATE_LIMIT_READ_PER_MIN=100
RATE_LIMIT_WRITE_PER_MIN=10
